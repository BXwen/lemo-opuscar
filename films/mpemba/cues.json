[
 {
  "t0": 0.14,
  "t1": 3.84,
  "text": "你信不信？热水比冷水先结冰"
 },
 {
  "t0": 4.35,
  "t1": 7.18,
  "text": "姆潘巴悬案"
 },
 {
  "t0": 7.69,
  "t1": 11.39,
  "text": "1963：热液没放凉，直接进冰柜"
 },
 {
  "t0": 12.55,
  "t1": 15.19,
  "text": "他先冻住了"
 },
 {
  "t0": 15.37,
  "t1": 19.95,
  "text": "两千年前，就有人记过"
 },
 {
  "t0": 20.28,
  "t1": 23.84,
  "text": "1969重查：热水先到冰点"
 },
 {
  "t0": 23.98,
  "t1": 26.62,
  "text": "合著论文《Cool?》"
 },
 {
  "t0": 26.94,
  "t1": 30.28,
  "text": "五个嫌疑人，逐一排查"
 },
 {
  "t0": 30.37,
  "t1": 34.4,
  "text": "哪个假说都解释不了全部现象"
 },
 {
  "t0": 34.54,
  "t1": 36.62,
  "text": "无定论"
 },
 {
  "t0": 36.76,
  "t1": 40.51,
  "text": "未结案 UNSOLVED"
 },
 {
  "t0": 40.83,
  "t1": 44.44,
  "text": "科学不怕悬案"
 },
 {
  "t0": 44.81,
  "t1": 48.84,
  "text": "就怕没人再问，下一个就是你"
 },
 {
  "t0": 48.94,
  "t1": 50.0,
  "text": "参考资料：Mpemba & Osborne 1969 · Aristotle · Bacon · Descartes · Burridge & Linden 2016"
 }
]